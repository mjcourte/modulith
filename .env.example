# Copy to .env for local development. Real environment variables override it.
# .env holds credentials: keep it out of version control.

GYOZA_DATABASE_URL=postgres://gyoza:gyoza@localhost:5432/gyoza
# debug, info, warn or error
GYOZA_LOG_LEVEL=info
# How long a clean shutdown may take before giving up. Keep it under the
# orchestrator's kill timeout (ECS sends SIGKILL 30s after SIGTERM by default).
GYOZA_SHUTDOWN_TIMEOUT=20s
