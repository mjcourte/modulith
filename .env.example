# Copy to .env for local development. Real environment variables override it.
# .env holds credentials: keep it out of version control.

# Postgres from deploy/monolith/compose.yaml (docker compose -f deploy/monolith/compose.yaml up -d --wait)
MODULITH_DATABASE_URL=postgres://modulith:modulith@localhost:5433/modulith
# or a locally installed Postgres with a modulith role and database:
# MODULITH_DATABASE_URL=postgres://modulith:modulith@localhost:5432/modulith
# debug, info, warn or error
MODULITH_LOG_LEVEL=info
# How long a clean shutdown may take before giving up. Keep it under the
# orchestrator's kill timeout (ECS sends SIGKILL 30s after SIGTERM by default).
MODULITH_SHUTDOWN_TIMEOUT=20s
# OpenTelemetry collector (OTLP over gRPC) the binaries send traces, logs and metrics to: SigNoz
# from deploy/observability (scripts/signoz.sh). Empty or unset: no telemetry.
# With SigNoz down, every export logs an error: comment it out then.
MODULITH_OTLP_ENDPOINT=http://localhost:4317
# Share of high-volume traces kept (WebSocket edits, deltas), 0 to 1. Other
# traces are always kept. 1 while debugging document traffic.
MODULITH_TRACE_HOT_RATE=0.01
# Serve Go profiles (pprof) here, for `go tool pprof http://localhost:6060/debug/pprof/profile`
# (CPU, 30s) or .../heap. Off when unset. Profiles expose internals: localhost only.
# MODULITH_DEBUG_ADDR=localhost:6060
# gRPC listen address. Deployments use ":9090" to listen on all interfaces.
# Defaults: the monolith localhost:9090, storage 9091, mediaprocessor 9092,
# iam 9093; set it per binary when running several.
MODULITH_GRPC_ADDR=localhost:9090

# S3: RustFS from deploy/monolith/compose.yaml. On AWS leave the endpoint
# empty and path style off.
MODULITH_S3_ENDPOINT=http://localhost:9000
MODULITH_S3_ACCESS_KEY=modulith
MODULITH_S3_SECRET_KEY=modulith-dev-secret
MODULITH_S3_PATH_STYLE=true
MODULITH_S3_BUCKET=modulith-dev
# Create the bucket at start-up (local development only).
MODULITH_S3_CREATE_BUCKET=true
# How long trashed files can be restored before the cleanup job deletes them.
# Go durations have no "d": 168h is 7 days.
MODULITH_TRASH_RETENTION=168h
# Document snapshots: how many to keep per project (the revert window), and
# the largest accepted, in bytes (32 MiB; snapshots hold ECS tables, not media).
MODULITH_SNAPSHOT_KEEP=100
MODULITH_SNAPSHOT_MAX_BYTES=33554432
MODULITH_CLEANUP_INTERVAL=10m
# How often the media probe job looks for new video/audio uploads. The monolith
# needs ffprobe on PATH; without it uploads stay queued.
MODULITH_PROBE_INTERVAL=10s
# Where cmd/storage finds cmd/mediaprocessor (its default listen address).
# cmd/mediaprocessor gets no secrets: run it without this file's S3/Postgres settings.
MODULITH_MEDIAPROCESSOR_ADDR=localhost:9092

# iam. cmd/storage asks cmd/iam who may do what; cmd/iam's deletions call
# cmd/storage back. The monolith runs both in-process and ignores these.
MODULITH_IAM_ADDR=localhost:9093
MODULITH_STORAGE_ADDR=localhost:9091
# cmd/iam's clones copy the document through cmd/documents.
MODULITH_DOCUMENTS_ADDR=localhost:9094
# How long an org invite can be accepted (14 days).
MODULITH_INVITE_TTL=336h
# How long a project shared with an address that has no account yet waits
# for someone to sign up with it, in days.
MODULITH_SHARE_EXPIRY_DAYS=30
# How often iam finishes interrupted deletions and removes expired invites
# and pending shares.
MODULITH_IAM_CLEANUP_INTERVAL=10m

# NATS from deploy/monolith/compose.yaml (comma-separated, any member works).
# Required by the binaries hosting documents (cmd/modulith, cmd/documents).
MODULITH_NATS_URL=nats://localhost:4222

# Documents (cmd/modulith, cmd/documents). Saves are debounced: 2s after edits
# stop, at most 30s after the first unsaved one. Idle documents leave memory
# after the TTL. The replica ID must be unique per running instance; unset, it
# is the host name plus a random suffix. Every replica shares one durable
# NATS consumer name.
# MODULITH_DOCUMENTS_REPLICA=
MODULITH_DOCUMENTS_DEBOUNCE=2s
MODULITH_DOCUMENTS_MAX_DELAY=30s
MODULITH_DOCUMENTS_TTL=10m
MODULITH_DOCUMENTS_CONSUMER=documents

# Dev admin UI (go run ./cmd/admin, see apps/admin/README.md). It lets anyone act
# as any user, so it refuses to start unless MODULITH_ADMIN=1.
# MODULITH_ADMIN=1
MODULITH_ADMIN_ADDR=localhost:8081
# Where it calls iam, storage and documents: the monolith serves all three on 9090.
MODULITH_ADMIN_IAM_ADDR=localhost:9090
MODULITH_ADMIN_STORAGE_ADDR=localhost:9090
MODULITH_ADMIN_DOCUMENTS_ADDR=localhost:9090

# gateway: the browser-facing HTTP API and sign-in (SuperTokens core from
# deploy/monolith/compose.yaml). The monolith and cmd/gateway serve it.
MODULITH_GATEWAY_ADDR=localhost:8080
# Where browsers reach the app; session cookies are scoped to it, and it is
# SuperTokens' website and API domain. In dev that is apps/web's Vite server,
# which proxies /api and /auth to the gateway (scripts/web.sh). Use
# http://localhost:8080 to sign in through the gateway's dev pages alone.
MODULITH_PUBLIC_URL=http://localhost:3000
MODULITH_SUPERTOKENS_URL=http://localhost:3567
# MODULITH_SUPERTOKENS_API_KEY=   (none for the local core)
# Google OAuth client for SuperTokens sign-in. For local development, take the demo
# client from SuperTokens' docs (their Google provider quickstart): sign-in routes
# through supertokens.io, so it works on localhost only. Otherwise use your own.
# Required before anything leaves localhost.
# Left unset here on purpose: GitHub's secret scanner reads the demo values as live
# credentials and blocks any push containing them.
MODULITH_GOOGLE_CLIENT_ID=
MODULITH_GOOGLE_CLIENT_SECRET=
# Dev-only pages at /dev/signin (sign-in, and boxes to call /api and the
# WebSocket), served on MODULITH_GATEWAY_ADDR. Never in production.
MODULITH_GATEWAY_DEV_PAGES=true
