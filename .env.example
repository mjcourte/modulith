# Copy to .env for local development. Real environment variables override it.
# .env holds credentials: keep it out of version control.

# Postgres from deploy/monolith/compose.yaml (docker compose -f deploy/monolith/compose.yaml up -d --wait)
GYOZA_DATABASE_URL=postgres://gyoza:gyoza@localhost:5433/gyoza
# or a locally installed Postgres with a gyoza role and database:
# GYOZA_DATABASE_URL=postgres://gyoza:gyoza@localhost:5432/gyoza
# debug, info, warn or error
GYOZA_LOG_LEVEL=info
# How long a clean shutdown may take before giving up. Keep it under the
# orchestrator's kill timeout (ECS sends SIGKILL 30s after SIGTERM by default).
GYOZA_SHUTDOWN_TIMEOUT=20s
# gRPC listen address. Deployments use ":9090" to listen on all interfaces.
# Defaults: the monolith localhost:9090, storage 9091, mediaprocessor 9092,
# iam 9093; set it per binary when running several.
GYOZA_GRPC_ADDR=localhost:9090

# S3: RustFS from deploy/monolith/compose.yaml. On AWS leave the endpoint
# empty and path style off.
GYOZA_S3_ENDPOINT=http://localhost:9000
GYOZA_S3_ACCESS_KEY=gyoza
GYOZA_S3_SECRET_KEY=gyoza-dev-secret
GYOZA_S3_PATH_STYLE=true
GYOZA_S3_BUCKET=gyoza-dev
# Create the bucket at start-up (local development only).
GYOZA_S3_CREATE_BUCKET=true
# How long trashed files can be restored before the cleanup job deletes them.
# Go durations have no "d": 168h is 7 days.
GYOZA_TRASH_RETENTION=168h
# Document snapshots: how many to keep per project (the revert window), and
# the largest accepted, in bytes (32 MiB; snapshots hold ECS tables, not media).
GYOZA_SNAPSHOT_KEEP=100
GYOZA_SNAPSHOT_MAX_BYTES=33554432
GYOZA_CLEANUP_INTERVAL=10m
# How often the media probe job looks for new video/audio uploads. The monolith
# needs ffprobe on PATH; without it uploads stay queued.
GYOZA_PROBE_INTERVAL=10s
# Where cmd/storage finds cmd/mediaprocessor (its default listen address).
# cmd/mediaprocessor gets no secrets: run it without this file's S3/Postgres settings.
GYOZA_MEDIAPROCESSOR_ADDR=localhost:9092

# iam. cmd/storage asks cmd/iam who may do what; cmd/iam's deletions call
# cmd/storage back. The monolith runs both in-process and ignores these.
GYOZA_IAM_ADDR=localhost:9093
GYOZA_STORAGE_ADDR=localhost:9091
# cmd/iam's clones copy the document through cmd/documents.
GYOZA_DOCUMENTS_ADDR=localhost:9094
# How long an org invite can be accepted (14 days).
GYOZA_INVITE_TTL=336h
# How often iam finishes interrupted deletions and removes expired invites.
GYOZA_IAM_CLEANUP_INTERVAL=10m

# NATS from deploy/monolith/compose.yaml (comma-separated, any member works).
# Required by the binaries hosting documents (cmd/gyoza, cmd/documents).
GYOZA_NATS_URL=nats://localhost:4222

# Documents (cmd/gyoza, cmd/documents). Saves are debounced: 2s after edits
# stop, at most 30s after the first unsaved one. Idle documents leave memory
# after the TTL. The replica ID must be unique per running instance; unset, it
# is the host name plus a random suffix. Every replica shares one durable
# NATS consumer name.
# GYOZA_DOCUMENTS_REPLICA=
GYOZA_DOCUMENTS_DEBOUNCE=2s
GYOZA_DOCUMENTS_MAX_DELAY=30s
GYOZA_DOCUMENTS_TTL=10m
GYOZA_DOCUMENTS_CONSUMER=documents

# Dev admin UI (go run ./cmd/admin, see apps/admin/README.md). It lets anyone act
# as any user, so it refuses to start unless GYOZA_ADMIN=1.
# GYOZA_ADMIN=1
GYOZA_ADMIN_ADDR=localhost:8081
# Where it calls iam, storage and documents: the monolith serves all three on 9090.
GYOZA_ADMIN_IAM_ADDR=localhost:9090
GYOZA_ADMIN_STORAGE_ADDR=localhost:9090
GYOZA_ADMIN_DOCUMENTS_ADDR=localhost:9090

# gateway: the browser-facing HTTP API and sign-in (SuperTokens core from
# deploy/monolith/compose.yaml). The monolith and cmd/gateway serve it.
GYOZA_GATEWAY_ADDR=localhost:8080
# Where browsers reach the app; session cookies are scoped to it, and it is
# SuperTokens' website and API domain. In dev that is apps/web's Vite server,
# which proxies /api and /auth to the gateway (scripts/web.sh). Use
# http://localhost:8080 to sign in through the gateway's dev pages alone.
GYOZA_PUBLIC_URL=http://localhost:3000
GYOZA_SUPERTOKENS_URL=http://localhost:3567
# GYOZA_SUPERTOKENS_API_KEY=   (none for the local core)
# SuperTokens' public demo Google client (from their docs): sign-in is routed
# through supertokens.io, so it works on localhost only. Replace with our own
# OAuth client before anything leaves localhost.
GYOZA_GOOGLE_CLIENT_ID=1060725074195-kmeum4crr01uirfl2op9kd5acmi9jutn.apps.googleusercontent.com
GYOZA_GOOGLE_CLIENT_SECRET=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
# ^^ these are public demo keys
# Dev-only pages at /dev/signin (sign-in, and boxes to call /api and the
# WebSocket), served on GYOZA_GATEWAY_ADDR. Never in production.
GYOZA_GATEWAY_DEV_PAGES=true
